{
  "name": "@playbykey/theory",
  "version": "2.0.1",
  "description": "Zero-dependency music theory engine for scales, modes, intervals, and key relationships.",
  "keywords": [
    "music-theory",
    "scales",
    "modes",
    "chords",
    "progressions",
    "intervals",
    "transposition",
    "midi",
    "key-signatures",
    "chord-detection",
    "circle-of-fifths",
    "roman-numerals"
  ],
  "homepage": "https://theory-engine.docs.playbykey.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalBrewLLC/playbykey-dev-tools"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
