{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.playbykey/theory-mcp",
  "description": "MCP server exposing @playbykey/theory as AI-callable music theory tools.",
  "version": "1.4.2",
  "repository": {
    "url": "https://github.com/DigitalBrewLLC/playbykey-dev-tools",
    "source": "github",
    "subfolder": "packages/theory-mcp"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@playbykey/theory-mcp",
      "version": "1.4.2",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
