---
import Default from '@astrojs/starlight/components/Footer.astro';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];

/** Brand-accurate icons for links Starlight's built-in icon set doesn't cover. */
const customIconSrc: Record<string, string> = {
  PlayByKey: '/playbykey-icon.svg',
  npm: '/npm-icon.svg',
};
---

<Default><slot /></Default>

<footer class="pbk-footer">
  <a href="https://playbykey.com" class="pbk-footer-cta">
    <img
      src="/playbykey-logo-light.svg"
      alt="PlayByKey"
      width="110"
      height="21"
      class="pbk-footer-logo pbk-footer-logo-light"
    />
    <img
      src="/playbykey-logo-dark.svg"
      alt="PlayByKey"
      width="110"
      height="21"
      class="pbk-footer-logo pbk-footer-logo-dark"
    />
    <span class="pbk-footer-cta-text">
      The music theory engine powering PlayByKey, a free interactive music theory learning tool.
    </span>
  </a>
  {
    links.length > 0 && (
      <div class="pbk-footer-links">
        {links.map(({ label, href, icon }) => (
          <a {href} rel="me" class="pbk-footer-link">
            {customIconSrc[label] ? (
              <img src={customIconSrc[label]} width="16" height="16" alt="" />
            ) : (
              <Icon name={icon} />
            )}
            <span>{label}</span>
          </a>
        ))}
      </div>
    )
  }
</footer>

<style>
  @layer starlight.core {
    .pbk-footer {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--sl-color-hairline);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .pbk-footer-cta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex: 1 1 auto;
      min-width: 16rem;
      padding: 0.75rem 1rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      color: var(--sl-color-gray-2);
      transition: border-color 0.15s ease;
    }
    .pbk-footer-cta:hover {
      border-color: var(--sl-color-accent);
      color: var(--sl-color-white);
    }
    .pbk-footer-logo {
      flex-shrink: 0;
    }
    .pbk-footer-logo-dark {
      display: none;
    }
    :root[data-theme='dark'] .pbk-footer-logo-light {
      display: none;
    }
    :root[data-theme='dark'] .pbk-footer-logo-dark {
      display: block;
    }
    .pbk-footer-cta-text {
      font-size: var(--sl-text-xs);
    }
    .pbk-footer-links {
      display: flex;
      gap: 0.5rem;
    }
    .pbk-footer-link {
      display: flex;
      align-items: center;
      gap: 0.375em;
      color: var(--sl-color-text-accent);
      font-size: var(--sl-text-xs);
      padding: 0.5em;
      margin: -0.5em;
    }
    .pbk-footer-link:hover {
      color: var(--sl-color-white);
    }
  }
</style>
